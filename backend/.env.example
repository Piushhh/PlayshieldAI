# Backend Environment Variables
# Copy to backend/.env for standalone development

DATABASE_URL=postgresql+asyncpg://ipguardian:changeme_db_password@localhost:5432/ipguardian
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=dev_secret_key_change_in_production_32chars
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=ipguardian-media
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
